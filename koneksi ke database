<?php endif; 

$query = "SELECT * FROM datapelajar"; 
$lemari = mysqli_query($conn, $query);
function query($query) {
    global $conn;
    $result = mysqli_query($conn, $query);
    $rows = [];
    while( $row = mysqli_fetch_assoc($result) ) {
        $rows[] = $row;
    }
    return $rows;
}

// Membuat fungsi tambah data
function tambah($data){
    global $conn;

	// Tangkap data yang dikirim dari form
	$nama = htmlspecialchars($data["nama"]); // Menggunakan htmlspecialchars agar lebih aman
	$umur = htmlspecialchars($data["umur"]);

    // Perbaikan: INSERT INTO (bukan INSER) dan memanggil variabel dengan '$nama' dan '$umur'
	$query = "INSERT INTO datapelajar VALUES ('', '$nama', '$umur')";

	mysqli_query($conn, $query);

    // Kembalikan angka (1 jika berhasil, -1 jika gagal)
	return mysqli_affected_rows($conn);
}

function hapus($id){

	global $conn;
	mysqli_query($conn,"DELETE FROM datapelajar WHERE id =$id");
	return mysqli_affected_rows($conn);
}
function update($data) {
    global $conn;
    
    // Tangkap data dari form dan bersihkan
    $id = $data["id"];
    $nama = htmlspecialchars($data["nama"]);
    $umur = htmlspecialchars($data["umur"]);

    // Kueri untuk mengubah data di database
    $query = "UPDATE datapelajar SET 
                nama = '$nama', 
                umur = '$umur' 
              WHERE id = $id";
              
    mysqli_query($conn, $query);

    // Mengembalikan jumlah baris yang berubah (1 jika berhasil, 0 jika tidak ada perubahan, -1 jika gagal)
    return mysqli_affected_rows($conn);
}
